# Internal API key shared with the website backend to authenticate requests.
CHESS_ENGINE_INTERNAL_KEY=replace-with-a-secure-random-string

# Anthropic API key for Claude-powered coaching narratives.
CLAUDE_API_KEY=sk-ant-...

# Database connection string (Postgres).
DATABASE_URL=postgresql://user:password@localhost:5432/chessnext

# Absolute path to the Stockfish binary. Leave empty to use mock evaluation.
STOCKFISH_PATH=
